# At least one transport token is required to run a bot.
TELEGRAM_BOT_TOKEN=
# MAX transport can be enabled with an HTTP gateway compatible with transports.MaxTransport.
MAX_BOT_TOKEN=
MAX_API_BASE_URL=
MAX_BOT_LINK=
ADMIN_IDS=123456789
# Telegram account IDs that receive new-client notifications (also for MAX leads).
MANAGER_IDS=123456789,987654321
TELEGRAM_BOT_USERNAME=
DATABASE_PATH=lawyer_tester.sqlite3
AMOCRM_BASE_URL=https://example.amocrm.ru
AMOCRM_ACCESS_TOKEN=
# Optional explicit target; otherwise the stage is discovered by name.
AMOCRM_TARGET_PIPELINE_NAME=Судебный приказ
AMOCRM_TARGET_STATUS_NAME=Готов к сотрудничеству
# Referral clients are created only in the A7 bot pipeline, never in Sinai settings.
AMOCRM_REFERRAL_PIPELINE_NAME=[A7] TG / Max - Боты
# Empty means the first regular stage of the pipeline.
AMOCRM_REFERRAL_STATUS_NAME=
AMOCRM_REQUESTS_PER_SECOND=4
A7_OFFER_URL=
A7_MANAGER_CONTACT_URL=
DEFAULT_BONUS_PER_CLIENT=10000
SECOND_LEVEL_BONUS=5000
MAILING_WORKER_INTERVAL_SECONDS=30
INACTIVITY_MINUTES=30
POLL_TIMEOUT_SECONDS=25
LOG_LEVEL=INFO
